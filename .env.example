# Clave secreta PIN de 4 digitos para el acceso propietario en Nidus
# En Vercel: anadir como Environment Variable en Project Settings -> Environment Variables
NEXT_PUBLIC_OWNER_PIN=0000

# Variables de Supabase para sincronización en tiempo real (móvil y portátil)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
