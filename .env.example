# ==============================================================================
# VARIABLES DE ENTORNO PARA NIDUS
# ==============================================================================

# 1. Seguridad y Autenticación del Propietario (Validado en Servidor)
# PIN numérico confidencial de 4 dígitos (NO se expone al cliente JavaScript)
APP_PIN=0000

# Secreto para firmar criptográficamente las cookies de sesión (HMAC-SHA256)
# Recomendado: genera una cadena aleatoria larga (ej: openssl rand -hex 32)
AUTH_SECRET=genera-una-clave-secreta-larga-para-produccion

# 2. Privacidad y Contacto (Opcional)
# Email visible en el modal público de solicitud de acceso para visitantes
NEXT_PUBLIC_CONTACT_EMAIL=tu-email-profesional@ejemplo.com

# Identificador de usuario único para aislar los datos (Opcional, por defecto: local-user)
NEXT_PUBLIC_USER_ID=local-user

# 3. Sincronización en la Nube con Supabase (Opcional para sincronizar móvil y portátil)
# Si no se configuran, Nidus opera al 100% en modo Local-First sin dependencias en la nube.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
